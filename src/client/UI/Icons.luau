--!strict
-- Glossy cartoon UI icons: SVG sources generated by tools/icons/make_icons.py (assets/ui-icons/src),
-- rendered to 512 px transparent PNGs and uploaded to Roblox. Icons.glow(parent) adds the soft glow used behind featured icons. Icons.view(parent, name, size?) -> ImageLabel.
-- Icons.rack(parent, tier) renders a live 3D preview of a training station (Shop only).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local IDS: { [string]: string } = {
	Shop = "rbxassetid://93294781213829",
	Index = "rbxassetid://102517293443898",
	Rebirth = "rbxassetid://71261019262412",
	Trade = "rbxassetid://74243416141687",
	Settings = "rbxassetid://84245192417477",
	Coins = "rbxassetid://87716585873855",
	WalkSpeed = "rbxassetid://100327618588257",
	Power = "rbxassetid://130642391715113",
	PetSlots = "rbxassetid://88628040109592",
	Pets = "rbxassetid://96366429916416",
	Hatch = "rbxassetid://80077964816211",
	Sound = "rbxassetid://74846258700334",
	Close = "rbxassetid://125377353826856",
	CoinBoost = "rbxassetid://112518185446007",
	Gamepasses = "rbxassetid://72514807777959",
	Luck = "rbxassetid://109138459067598",
	Quests = "rbxassetid://122876216431307",
	New = "rbxassetid://84108823188668",
	Glow = "rbxassetid://110070937482051",
	Shield = "rbxassetid://77216163319959",
	Rays = "rbxassetid://133942308484025",
	Spark = "rbxassetid://125277121997681",
}
-- older names used around the UI
IDS.Cart, IDS.Chest, IDS.Book, IDS.Gear = IDS.Shop, IDS.Shop, IDS.Index, IDS.Settings
IDS.Cash, IDS.Boot, IDS.Bolt, IDS.Egg, IDS.Paw = IDS.Coins, IDS.WalkSpeed, IDS.Power, IDS.PetSlots, IDS.Pets

local Icons = {}

function Icons.view(parent: Instance, name: string, size: UDim2?): ImageLabel
	local img = Instance.new("ImageLabel")
	img.Name = name .. "Icon"
	img.BackgroundTransparency = 1
	img.Size = size or UDim2.fromScale(1, 1)
	img.Image = IDS[name] or ""
	img.ScaleType = Enum.ScaleType.Fit
	img.Parent = parent
	return img
end

function Icons.glow(parent: Instance, size: UDim2?): ImageLabel
	local img = Icons.view(parent, "Glow", size)
	img.Name = "Glow"
	img.ZIndex = 0
	img.ImageTransparency = 0.35
	return img
end

function Icons.rack(parent: Instance, tier: string, size: UDim2?): ViewportFrame
	local Shared = ReplicatedStorage:WaitForChild("Shared")
	local Builder = require(Shared:WaitForChild("Builders"):WaitForChild("BlockBuilder")) :: any
	local TrainingRack = require((Shared :: any).Builders.Map.TrainingRack) :: any
	local vp = Instance.new("ViewportFrame")
	vp.Name = "Rack" .. tier
	vp.BackgroundTransparency = 1
	vp.Size = size or UDim2.fromScale(1, 1)
	vp.Ambient = Color3.fromRGB(200, 200, 205)
	vp.LightDirection = Vector3.new(-0.5, -1, -0.8)
	local model = Builder.build(TrainingRack.spec(tier), "Rack")
	model:PivotTo(CFrame.new())
	model.Parent = vp
	local cf, sz = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local dist = sz.Magnitude / 2 / math.tan(math.rad(15)) * 1.05
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist * 0.55, dist * 0.3, -dist * 0.8), cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	return vp
end

return Icons
