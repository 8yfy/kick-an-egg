--!strict
-- Premium Roblox Simulator SFX: the approved sound set, uploaded to Roblox and keyed by SoundBank event.
-- Source: the "Kick an Egg SFX" workspace (sounds/premium_v1, 167 procedural WAVs); imported in Studio's Asset
-- Manager as KAE_<event>[_v<n>]. `ids` is generated by that workspace's premium_ids.py from the import:
-- regenerate it instead of typing ids by hand (never invent ids). SoundBank turns every entry into a
-- SoundBank.CUSTOM replacement; an event with no ids keeps its built-in recipe, so the game never goes silent.
--   ids[event] = { asset } or { variant1, variant2, ... } (Audio picks a different variant each play)
--   sacks use "Sack<tier>.<moment>", landings "EggLand_<surface>" / "EggBounce_<surface>", weather accents
--   "MutationAccent_<Mutation>", loops (AvalancheRoll, Sack<tier>.idle) loop by themselves.
local PremiumSfx = {}

-- Every file is loudness-matched per tier (routine UI about -20 LUFS ... spectacular -13), so one volume fits all.
PremiumSfx.volume = 0.5
-- Per-event volume tweaks after listening in game (multiplies `volume`), e.g. UIClick = 0.8.
PremiumSfx.gain = {} :: { [string]: number }
-- Transposed per zone like the built-in tone layer (ZoneEnter rises with every zone).
PremiumSfx.tune = { ZoneEnter = true } :: { [string]: boolean }

-- BEGIN GENERATED (premium_ids.py): ids per event, and each file's length in seconds (the longest variant) so
-- Audio cleans up and counts voices correctly.
PremiumSfx.ids = {} :: { [string]: { string } }
PremiumSfx.seconds = {} :: { [string]: number }
-- END GENERATED

return PremiumSfx
