local FRUIT, SEED, SEED_LT = rgb(255, 51, 85), rgb(140, 255, 74), rgb(230, 255, 184)

local function leaves(y: number, area: { number }, rate: number, colors: { Color3 }?): Layer
	return {
		kind = "emit",
		sprite = "meadow_leaf",
		y = y,
		area = area,
		rate = rate,
		life = { 3.5, 4.5 },
		size = { 0.42, 0.36 },
		accel = { 0, -0.5, 0 },
		drag = 0.6,
		spin = { -90, 90 },
		color = colors or { LEAF, LEAF_LT },
		alpha = { 1, 0, 0, 1 },
	}
end

