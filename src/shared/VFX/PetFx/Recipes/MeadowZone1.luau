-- Zone 1 Meadow, the remodelled roster (KickAnEgg_PremiumPets/Zone01_Meadow): egg + pet effect recipes (VFX/PetFx).
-- Each pet's three ideas come from its reference sheet ("Animation / VFX ideas"), its special is the one in the
-- handoff, synced to its Anim/PetProfiles motion (`delay` lands the burst on the gesture's climax). Rarer pets get
-- more layers, more glow and more particles. Keys are the model keys; nothing points at them until the roster is
-- wired into Config/Pets.
local rgb = Color3.fromRGB

type Layer = { [string]: any }
type Pair = { egg: { layers: { Layer } }, pet: { layers: { Layer } } }

local WHITE = rgb(255, 255, 255)
local LEAF, LEAF_LT, LEAF_DK = rgb(124, 207, 46), rgb(181, 232, 90), rgb(62, 154, 42)
local POLLEN, GOLD, GOLD_LT = rgb(255, 211, 78), rgb(242, 182, 50), rgb(255, 226, 122)
local HONEY, AMBER = rgb(255, 196, 60), rgb(255, 154, 31)
